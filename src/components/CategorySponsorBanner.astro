---
import { getCollection } from 'astro:content';
import type { BannerSponsor } from 'src/content.config';

import generateUrlWithUTM from '@/utils/generateUrlWithUTM';

/**
 * The props for the CategorySponsorBanner component
 * @param {string} categoryId - The category id this sponsorship should show in.
 */
type Props = {
  categoryId: string;
};

const { categoryId } = Astro.props;

const bannerSponsorsCollection = await getCollection('banner-sponsors');
const sponsors = bannerSponsorsCollection.map((sponsor) => sponsor.data);

// Find the first sponsor that matches the category and has position 'category'
const sponsor = sponsors
  .find((sponsor: BannerSponsor) => {
    return sponsor.position == 'category' 
      && sponsor.categories?.includes(categoryId);
  });
const hasSponsor = !!sponsor;

---

<section
  class="z-20 flex w-full flex-col-reverse justify-between bg-slate-800 p-px py-2 text-xs font-medium text-slate-100/90 text-white md:flex-row md:gap-2"
  id="sponsor-banner"
>
  {hasSponsor ? (
    <>
      <a
        id="sponsor-banner-link"
        href={generateUrlWithUTM({
          url: sponsor.ctaUrl,
          linkPlacementDescription: 'rotating sponsor banner',
        })}
        target="_blank"
        rel="sponsored nofollow noopener noreferrer"
        class="flex h-16 w-full rounded-xl"
      >
        <div class="flex w-full flex-row items-center gap-2 px-2 py-3 pr-4">
          <span>
            Category sponsored by{' '}
            <span class="text-pink-600 md:text-white">{sponsor.name}</span>
            {' '}- {sponsor.description}
            <span
              class="ml-2 hidden break-inside-avoid rounded-full bg-pink-600 px-4 whitespace-pre text-white hover:bg-pink-600/80 active:bg-pink-600/90 md:inline-block md:py-2"
            >
              {sponsor.ctaText}
            </span>
          </span>
        </div>
      </a>
      <a
        id="become-sponsor-link"
        class="flex items-center px-2 py-1 text-nowrap md:justify-end"
        href="/sponsor"
      >
        <span class="text-white">Sponsor OpenAPI.tools</span>
      </a>

      <div id="sponsor-banner-data" data-sponsor-name={sponsor.name} hidden></div>
    </>
  )
  : (
    <a
      id="become-sponsor-link"
      class="flex items-center px-2 py-1 text-nowrap md:justify-end"
      href="/sponsor"
    >
      <span class="text-white">Sponsor OpenAPI.tools to show how much your company supports the OpenAPI community. The name of your company could be here in front of thousands of monthly API developers.</span>
    </a>
  )}
</section>

<script>
  import { trackSponsorshipCTA } from '@/utils/analytics';

  const sponsorName = document.getElementById('sponsor-banner-data')?.dataset
    .sponsorName;

  document
    .getElementById('sponsor-banner-link')
    ?.addEventListener('click', () => {
      trackSponsorshipCTA({
        cta_type: 'banner_click',
        source_page: window.location.pathname,
        sponsor_name: sponsorName,
      });
    });

  document
    .getElementById('become-sponsor-link')
    ?.addEventListener('click', () => {
      trackSponsorshipCTA({
        cta_type: 'become_category_sponsor_link',
        source_page: window.location.pathname,
      });
    });
</script>
